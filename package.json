{
  "name": "alibi-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5278",
    "build": "next build",
    "start": "npm run preview",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "studio:dev": "sanity dev --port 3338",
    "studio:deploy": "sanity deploy",
    "verify:cloud": "node --experimental-strip-types scripts/verify-cloud.ts",
    "preview": "python3 -m http.server 5278 --bind 127.0.0.1 --directory out"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@sanity/client": "8.9.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2",
    "sanity": "6.17.0",
    "styled-components": "^6.1.19"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1",
      "undici": "7.29.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.0"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    },
    "adm-zip": "0.6.1",
    "smol-toml": "1.9.0",
    "uuid": "11.1.1"
  }
}
